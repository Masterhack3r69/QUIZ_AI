PORT=5000
MONGODB_URI=mongodb://localhost:27017/quiz_ai
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Email Service Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM="Quiz AI <noreply@quizai.com>"

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60

# Agentic Pipeline Feature Flags
ENABLE_AGENTIC_PIPELINE=false
ENABLE_QUALITY_VALIDATION=false
ENABLE_QUESTION_IMPROVEMENT=false

# AI Provider Configuration (for agentic pipeline)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
AI_TASK_CONFIG=development
