{
  "name": "quiz-ai-backend",
  "version": "1.0.0",
  "description": "Backend API for AI-Powered Quiz Generator",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:mongo-only": "nodemon src/server.mongo.js",
    "start": "node src/server.js",
    "start:mongo-only": "node src/server.mongo.js",
    "migrate:verify-users": "node scripts/migrate-existing-users.js",
    "cleanup:users": "node scripts/cleanup-test-users.js",
    "cleanup:unverified": "node scripts/cleanup-unverified-users.js",
    "migrate:postgres": "node scripts/migrate-to-postgres.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure-rest/ai-inference": "1.0.0-beta.6",
    "pg": "^8.13.1",
    "@azure/core-auth": "^1.10.1",
    "@azure/core-sse": "^2.3.0",
    "@google/genai": "^1.0.0",
    "axios": "^1.13.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "mongoose": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "pdf-parse": "^1.1.1",
    "youtubei.js": "^16.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4"
  }
}
