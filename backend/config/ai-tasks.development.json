{
  "tasks": {
    "content-extraction": {
      "primary": "github",
      "fallback": ["openrouter", "gemini", "ollama"],
      "maxRetries": 2,
      "timeout": 120000
    },
    "question-generation": {
      "primary": "github",
      "fallback": ["openrouter", "gemini", "ollama"],
      "maxRetries": 2,
      "timeout": 180000
    },
    "quality-validation": {
      "primary": "github",
      "fallback": ["openrouter", "gemini", "ollama"],
      "maxRetries": 2,
      "timeout": 120000
    },
    "question-improvement": {
      "primary": "github",
      "fallback": ["openrouter", "gemini", "ollama"],
      "maxRetries": 2,
      "timeout": 120000
    },
    "analytics": {
      "primary": "github",
      "fallback": ["openrouter", "gemini", "ollama"],
      "maxRetries": 2,
      "timeout": 120000
    }
  },
  "providers": {
    "github": {
      "enabled": true,
      "endpoint": "https://models.github.ai/inference",
      "model": "meta/Llama-4-Scout-17B-16E-Instruct"
    },
    "ollama": {
      "enabled": true,
      "baseURL": "http://localhost:11434",
      "model": "llama3.2:1b"
    },
    "openrouter": {
      "enabled": true,
      "baseURL": "https://openrouter.ai/api/v1",
      "models": {
        "free": "qwen/qwen-2.5-72b-instruct:free",
        "fast": "mistralai/mistral-7b-instruct:free",
        "quality": "nousresearch/hermes-3-llama-3.1-405b:free"
      }
    },
    "gemini": {
      "enabled": true,
      "model": "gemini-2.0-flash-exp"
    }
  }
}
